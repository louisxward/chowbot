# Copy to .env and fill in. Variables already set in the environment take precedence.

# Required: Discord bot token and application client ID
TOKEN=
CLIENT_ID=

# Bearer token for the admin API (POST /admin/*). Leave empty to disable the admin API.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=

# Optional
# PORT=33002
# INVENCHECKER_API_URL=http://localhost:33001   (docker-compose.yml uses http://invenchecker:33001)
# LOG_LEVEL=info
